+      oss << "    (inlined) " << inliner.filename << ":" << inliner.line;
+      if (!inliner.function.empty()) {
+        oss << " in " << inliner.function;
+      }
+      oss << "\n";
     }
-    rv += absl::StrFormat("%p  %s\n", addresses[i], symbol);
